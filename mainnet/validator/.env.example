# ─────────────────────────────────────────────────────────────────────────────
# Orbinum Mainnet — VALIDATOR node
#
# Copy to `.env` on the validator VPS and fill in the values below:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Container image (override to pin a specific tag)
ORBINUM_IMAGE=ghcr.io/orbinum/node:mainnet-latest

# Friendly name shown in telemetry. Pick something identifiable.
VALIDATOR_NAME=Choose-Your-Validator-Name

# Report to Orbinum's telemetry — https://telemetry.orbinum.network
#
# On by default. Reporting publishes this node's name, version, block height,
# peer count and approximate location; set this to empty to opt out.
#
# The trailing slash and the verbosity level are both required, and the whole
# value must stay quoted — the node parses "<url> <level>" as one argument.
#
# Validators report at level 1, where the node also sends `afg.authority_set`
# — the only message carrying its validator address, which the dashboard shows
# in the Address column. Level 0 omits it, so the column stays empty. The cost
# is per-block chatter the dashboard discards. RPC nodes stay at 0: they have
# no address to report.
TELEMETRY_URL=--telemetry-url "wss://telemetry.orbinum.io/submit/ 1"

# This validator's libp2p node-key (hex, 64 chars). Generate with:
#   openssl rand -hex 32
VALIDATOR_NODE_KEY=

# P2P bind address. The node binds 0.0.0.0:30333, auto-detects its public
# address, and discovers the network through the bootNodes baked into
# chainspec/mainnet-spec.json. Make sure TCP port 30333 is open and publicly
# reachable. Leave at 0.0.0.0 unless you bind to a specific interface.
P2P_BIND=0.0.0.0
