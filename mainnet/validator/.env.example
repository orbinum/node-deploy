# ─────────────────────────────────────────────────────────────────────────────
# Orbinum Mainnet — VALIDATOR node
#
# Copy to `.env` on the validator VPS and fill in the values below:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Container image (override to pin a specific tag)
ORBINUM_IMAGE=ghcr.io/orbinum/node:mainnet-latest

# Friendly name shown in telemetry. Pick something identifiable.
VALIDATOR_NAME=Choose-Your-Validator-Name

# This validator's libp2p node-key (hex, 64 chars). Generate with:
#   openssl rand -hex 32
VALIDATOR_NODE_KEY=

# P2P bind address. The node binds 0.0.0.0:30333, auto-detects its public
# address, and discovers the network through the bootNodes baked into
# chainspec/mainnet-spec.json. Make sure TCP port 30333 is open and publicly
# reachable. Leave at 0.0.0.0 unless you bind to a specific interface.
P2P_BIND=0.0.0.0
