# ═══ Orbinum Mainnet — public RPC ════════════════════════════════════════════
# cp .env.example .env
#
# TLS: Caddy terminates HTTPS/WSS with a Cloudflare Origin Certificate. Drop
# origin.pem / origin.key next to this file before starting, and set the DNS
# record to Proxied (orange cloud).
# ═════════════════════════════════════════════════════════════════════════════

# ─── Identity ────────────────────────────────────────────────────────────────

ORBINUM_IMAGE=ghcr.io/orbinum/node:mainnet-latest

# Shown in telemetry. Use rpc-1 / rpc-2 / ... per node.
RPC_NAME=Orbinum-RPC-1

# libp2p node-key, hex 64 chars — unique per node.
#   openssl rand -hex 32
RPC_NODE_KEY=

# Public domain. Caddy proxies HTTPS/WSS to localhost on RPC_PORT.
RPC_DOMAIN=rpc-1.orbinum.io

# ─── Telemetry ───────────────────────────────────────────────────────────────

# https://telemetry.orbinum.network — on by default. Publishes name, version,
# height, peer count, approximate location. Empty to opt out.
#
# Level 0 is the standard detail; higher levels add per-block chatter. RPCs stay
# at 0 — they have no validator address to report.
#
# Keep it quoted and keep the trailing slash — the node parses "<url> <level>"
# as one argument.
TELEMETRY_URL=--telemetry-url "wss://telemetry.orbinum.io/submit/ 0"

# ─── Peering ─────────────────────────────────────────────────────────────────

# Empty by default: a public RPC should discover peers freely.
#
# Pin it during a recovery. The chainspec's bootNodes are the RPCs themselves,
# so a freshly purged RPC discovers whatever is on the network — including a
# third-party node still serving a dead fork, which it will sync from because
# that chain is longer. Restricting it to your own validators for the duration
# of the resync is what stops that; clear it again afterwards.
#   RESERVED_NODES=--reserved-only --reserved-nodes /ip4/<validator-ip>/tcp/30333/p2p/<peer-id>
RESERVED_NODES=

# ─── Resources ───────────────────────────────────────────────────────────────
# Caps for the node container, so a query flood can't starve the host (Caddy,
# SSH, the OS). Always leave RAM and CPU for the host — never give the container
# the full core count. Scale to your server.

RPC_MEM_LIMIT=6g
RPC_CPUS=1.5

# ─── Ports ───────────────────────────────────────────────────────────────────
# This stack runs `network_mode: host`, so these bind DIRECTLY on the host —
# there is no container port mapping in between. Changing one moves the real
# listening socket.

# Open it in the firewall: must stay publicly reachable or this node gets no
# peers.
P2P_PORT=30333

# The port the node listens on AND the port Caddy proxies to over loopback —
# both read this one variable, so they cannot drift apart.
#
# Internal only: public traffic arrives on 443 at RPC_DOMAIN and Caddy forwards
# it here, so changing this does NOT change the public endpoint. Keep it
# firewalled (`ufw deny <port>`) — clients must go through Caddy, which is what
# applies the rate limits.
RPC_PORT=9944

# With host networking this binds on the public NIC — firewall it to the
# monitoring VPS only.
METRICS_PORT=9615
