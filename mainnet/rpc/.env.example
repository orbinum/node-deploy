# ─────────────────────────────────────────────────────────────────────────────
# Orbinum Mainnet — public RPC node
#
# Copy to `.env` on the RPC VPS and fill in the values below:
#   cp .env.example .env
#
# TLS: Caddy terminates HTTPS/WSS with a Cloudflare Origin Certificate. Drop
# origin.pem / origin.key next to this file before starting. The DNS record
# must be Proxied (orange cloud) in Cloudflare.
# ─────────────────────────────────────────────────────────────────────────────

# Container image (override to pin a specific tag)
ORBINUM_IMAGE=ghcr.io/orbinum/node:mainnet-latest

# Friendly name shown in telemetry. Use rpc-1 / rpc-2 / ... per node.
RPC_NAME=Orbinum-RPC-1

# Report to Orbinum's telemetry — https://telemetry.orbinum.network
#
# On by default. Reporting publishes this node's name, version, block height,
# peer count and approximate location; set this to empty to opt out.
#
# The trailing slash and the verbosity level are both required, and the whole
# value must stay quoted — the node parses "<url> <level>" as one argument.
# Level 0 is the standard detail level; higher levels add per-block chatter.
TELEMETRY_URL=--telemetry-url "wss://telemetry.orbinum.io/submit/ 0"

# This RPC's libp2p node-key (hex, 64 chars). Generate with:
#   openssl rand -hex 32
RPC_NODE_KEY=

# Peers this node is allowed to talk to. Empty by default: a public RPC should
# discover peers freely.
#
# Pin it during a recovery. The chainspec's bootNodes are the RPCs themselves,
# so a freshly purged RPC discovers whatever is on the network — including a
# third-party node still serving a dead fork, which it will happily sync from
# because that chain is longer. Restricting it to your own validators for the
# duration of the resync is what stops that; clear it again afterwards.
#
#   RESERVED_NODES=--reserved-only --reserved-nodes /ip4/<validator-ip>/tcp/30333/p2p/<peer-id> --reserved-nodes /ip4/<validator-ip>/tcp/30333/p2p/<peer-id>
RESERVED_NODES=

# Public domain for this RPC. Caddy proxies HTTPS/WSS to localhost on RPC_PORT.
# Use rpc-1 / rpc-2 / ... per node.
RPC_DOMAIN=rpc-1.orbinum.io

# Resource caps for the node container, so a query flood can't starve the host.
# Always leave some RAM and CPU for the host — never give the container the full
# core count. Scale to match your server.
RPC_MEM_LIMIT=6g
RPC_CPUS=1.5

# ─── HOST ports ──────────────────────────────────────────────────────────────
# This node runs with `network_mode: host`, so these flags bind DIRECTLY on the
# host — there is no container port mapping in between. Changing a value here
# moves the real listening socket.

# P2P port. If you change it, open it in the firewall: it must stay publicly
# reachable or this node gets no peers.
#   P2P_PORT=34105
P2P_PORT=30333

# RPC port the node listens on, and the port Caddy proxies to over loopback.
# Both sides read this one variable, so they can never drift apart.
#
# This is an internal port: public traffic arrives on 443 at RPC_DOMAIN and
# Caddy forwards it here. Changing it does NOT change the public endpoint.
# Keep it firewalled (`ufw deny <port>`) — clients must go through Caddy, which
# is what applies the rate limits.
RPC_PORT=9944

# Prometheus metrics port. With host networking this binds on the public NIC,
# so keep it firewalled to the monitoring VPS only.
METRICS_PORT=9615
