# Reverse proxy for the public RPC endpoint.
#
# Caddy terminates TLS, owns CORS, rate-limits per client IP and pools upstream
# connections to the node. Two upstream snippets — one for WebSocket, one for
# HTTP JSON-RPC — because the two have opposite pooling needs.
#
# ── Deploying a change to this file ─────────────────────────────────────────
#
#   docker compose up -d --force-recreate caddy
#
# `--force-recreate`, never restart or reload. The file is bind-mounted and
# `git pull` replaces it rather than editing in place, so the old inode stays
# mounted and the container keeps serving the previous config. Confirm the
# container agrees with the host before believing a deploy landed — different
# line numbers mean different files:
#
#   grep -n max_conns_per_host common/Caddyfile
#   docker compose exec caddy grep -n max_conns_per_host /etc/caddy/Caddyfile
#
# ── The connection budget ───────────────────────────────────────────────────
#
# `max_conns_per_host` applies PER IMPORT, not per snippet, and each snippet is
# imported twice: once for the Cloudflare-proxied branch, once for direct
# origin. Four transport blocks, so the ceiling is 500+500+400+400 = 1800
# against the node's --rpc-max-connections 5000. Check it, do not assume it:
#
#   caddy adapt --config Caddyfile | grep -o '"max_conns_per_host":[0-9]*'
#
# `tests/test_caddy_conn_cap.py` asserts the sum stays under the node's limit.
#
# Getting this wrong is what caused the 2026-09-14 outage: the caps were 1500
# each, the real ceiling was 3800 rather than the 1900 a stale comment claimed,
# and long-lived WebSockets reached the node's limit. The node then answered
# "Too many connections" to everyone — including the ISMP relayer, which lost
# its subscription for 38 minutes.

# caddy-ratelimit is not a standard directive, so it must be ordered explicitly.
{
	order rate_limit before basic_auth
}

# Both snippets strip the node's CORS headers so only Caddy's single copy
# survives — the node also emits CORS via --rpc-cors all, and duplicates make
# the browser reject the response with "multiple values '*, *'".

# WebSocket: long-lived 1:1 streams that cannot be pooled, so the cap has to
# cover the real concurrent-socket count.
(rpc_upstream_ws) {
	reverse_proxy localhost:{$RPC_PORT:9944} {
		# Without immediate flushing Caddy buffers frames and stalls idle
		# sockets, which shows up as WS dying after seconds and clients
		# reconnecting in a loop.
		flush_interval -1
		transport http {
			max_conns_per_host 500

			# A WebSocket has no request boundary, so nothing tells Caddy the
			# client is gone: a closed laptop or a killed tab leaves the
			# upstream half open, holding its slot forever. TCP keepalive
			# probes travel on the socket itself, so a vanished peer fails to
			# answer and the connection is reaped. Without this the count only
			# rises — an accumulation bug that worsens with uptime, not load,
			# which is why it survived every capacity estimate.
			keepalive_interval 30s

			# A node that accepts the handshake but never completes the upgrade
			# — starting, or mid-restart — would otherwise hold a slot for the
			# OS default, minutes, for every retrying client.
			dial_timeout 10s
		}
		header_down -Access-Control-Allow-Origin
		header_down -Access-Control-Allow-Methods
		header_down -Access-Control-Allow-Headers
		header_down -Access-Control-Expose-Headers
		header_down -Vary
	}
}

# HTTP JSON-RPC: POSTs finish in milliseconds, so a small keepalive pool serves
# thousands of req/s. No flush_interval — buffering is what lets these
# connections be reused instead of held open per client.
(rpc_upstream) {
	reverse_proxy localhost:{$RPC_PORT:9944} {
		transport http {
			max_conns_per_host 400
			# Idle connections retire on their own here, which is why this side
			# did not fall over on 2026-09-14.
			keepalive_idle_conns 100
			keepalive 60s
			dial_timeout 10s
		}
		header_down -Access-Control-Allow-Origin
		header_down -Access-Control-Allow-Methods
		header_down -Access-Control-Allow-Headers
		header_down -Access-Control-Expose-Headers
		header_down -Vary
	}
}

{$RPC_DOMAIN:rpc.example.invalid} {
	tls /etc/caddy/origin.pem /etc/caddy/origin.key

	# Who gets 429'd, with which client IP, and whether the 429 came from Caddy
	# (Retry-After present) or the node ("Too many connections" body).
	log {
		output file /data/access.log {
			roll_size 50mb
			roll_keep 3
		}
		format json
	}

	# ── CORS ────────────────────────────────────────────────────────────────
	# Set at the Caddy layer, not just the proxy, so Caddy-generated responses
	# carry CORS too. A rate-limit 429 without CORS is what the browser turns
	# into an opaque "CORS error", which is how this broke the explorer.
	header {
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, POST, OPTIONS"
		Access-Control-Allow-Headers "Content-Type"
		Access-Control-Max-Age "86400"
	}

	# Answer preflight here so the browser's OPTIONS probe never reaches the
	# node or the rate limiter — a throttled preflight blocks the real request.
	@options method OPTIONS
	respond @options 204

	# ── Rate limits ─────────────────────────────────────────────────────────
	# Both sections split by traffic source: Cloudflare-proxied requests are
	# keyed on the client IP CF forwards, because the direct peer is always a CF
	# edge and {remote_host} would put everyone in one bucket. Direct-origin
	# requests get their own zone, so a missing header can never collapse every
	# client into a shared bucket.

	# One upgrade is one event, so this caps how often an IP may (re)open a
	# socket — NOT how long one stays open. A healthy client opens one and holds
	# it, so 30/60s is ample for a page reload while a bot that reconnects every
	# few seconds trips it.
	@websocket header Connection *Upgrade*
	handle @websocket {
		@wsViaCf header CF-Connecting-IP *
		handle @wsViaCf {
			rate_limit {
				zone ws_cf {
					key {http.request.header.CF-Connecting-IP}
					events 30
					window 60s
				}
			}
			import rpc_upstream_ws
		}
		handle {
			rate_limit {
				zone ws_direct {
					key {remote_host}
					events 30
					window 60s
				}
			}
			import rpc_upstream_ws
		}
	}

	# 500 events / 10s = 50 req/s per IP: headroom for explorers, wallets and
	# light bots that burst, while still capping an abusive one.
	@viaCf header CF-Connecting-IP *
	handle @viaCf {
		rate_limit {
			zone rpc_cf {
				key {http.request.header.CF-Connecting-IP}
				events 500
				window 10s
			}
		}
		import rpc_upstream
	}

	handle {
		rate_limit {
			zone rpc_direct {
				key {remote_host}
				events 500
				window 10s
			}
		}
		import rpc_upstream
	}
}
