# ─────────────────────────────────────────────────────────────────────────────
# Orbinum Testnet — dedicated ARCHIVE RPC for the indexer
#
#   cp .env.example .env
#
# Runs on the same box as the indexer writer. RPC is loopback-only (no Caddy,
# no public exposure), so no TLS/origin cert is needed here.
# ─────────────────────────────────────────────────────────────────────────────

# Container image (override to pin a specific tag)
ORBINUM_IMAGE=ghcr.io/orbinum/node:testnet-latest

# Friendly name shown in telemetry.
RPC_NAME=Orbinum-Indexer-RPC

# This node's libp2p node-key (hex, 64 chars). Generate with:
#   openssl rand -hex 32
# Must be distinct from every other node's key.
RPC_NODE_KEY=

# Optional — peering for a PRIVATE network. Leave EMPTY to discover the public
# testnet through the chain-spec bootnodes. For a private/isolated network, pin
# reserved peers (and add --reserved-only to talk ONLY to them):
#   RESERVED_NODES=--reserved-only --reserved-nodes /ip4/<peer-ip>/tcp/30333/p2p/<peer-id> --reserved-nodes /ip4/<peer-ip>/tcp/30333/p2p/<peer-id>
RESERVED_NODES=

# Public node → set to "--no-private-ipv4" (ignore RFC1918 peers). Private
# network whose reserved peers use internal IPs (10.x / 192.168.x / 172.16.x)
# → leave EMPTY, or that flag blocks peering with them.
NO_PRIVATE_IPV4=--no-private-ipv4

# Resource caps. Archive keeps full state — give it enough RAM/cache but always
# leave headroom for the indexer writer + OS on the same box.
RPC_MEM_LIMIT=4g
RPC_CPUS=1.5
RPC_DB_CACHE=1024
RPC_TRIE_CACHE=134217728
