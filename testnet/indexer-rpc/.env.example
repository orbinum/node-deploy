# ═══ Orbinum Testnet — ARCHIVE RPC for the indexer ═══════════════════════════
# cp .env.example .env
#
# Runs on the same box as the indexer writer. RPC is loopback-only (no Caddy,
# no public exposure), so no TLS/origin cert is needed here.
# ═════════════════════════════════════════════════════════════════════════════

# ─── Identity ────────────────────────────────────────────────────────────────

ORBINUM_IMAGE=ghcr.io/orbinum/node:testnet-latest

RPC_NAME=Orbinum-Indexer-RPC

# libp2p node-key, hex 64 chars — unique per node.
#   openssl rand -hex 32
RPC_NODE_KEY=

# ─── Telemetry ───────────────────────────────────────────────────────────────

# https://telemetry.orbinum.network — on by default. Empty to opt out.
#
# This node is loopback-only, but telemetry is an OUTBOUND connection, so
# reporting does not expose the RPC. Worth keeping on: a lagging indexer RPC is
# why the explorer falls behind, and telemetry shows that at a glance.
#
# Keep it quoted and keep the trailing slash — the node parses "<url> <level>"
# as one argument.
TELEMETRY_URL=--telemetry-url "wss://telemetry.orbinum.io/submit/ 0"

# ─── Peering ─────────────────────────────────────────────────────────────────

# This node is OUTBOUND-ONLY: it dials the network to sync, but nothing dials
# it. Binding to the private IP (not 0.0.0.0) keeps the listener off the public
# interface entirely. Empty = 0.0.0.0.
#
# There is deliberately NO --public-addr: the node never advertises a reachable
# address, so no peer tries to connect inbound. Do NOT open P2P_PORT inbound on
# the firewall — outbound connections still get their replies via conntrack,
# which is all syncing needs.
#   P2P_BIND=<this-node-private-ip>
P2P_BIND=

# Peering for the PRIVATE network. Empty = discover the public testnet through
# the chainspec bootNodes.
#
# --reserved-only makes this node talk ONLY to the listed peers, never to public
# ones. Every entry is dialed outbound. Omit this node's own address.
#   RESERVED_NODES=--reserved-only --reserved-nodes /ip4/<peer-ip>/tcp/30333/p2p/<peer-id>
RESERVED_NODES=

# Public node → "--no-private-ipv4" (ignore RFC1918 peers). Private network
# whose reserved peers use internal IPs (10.x / 192.168.x / 172.16.x) → leave
# EMPTY, or this flag makes the node ignore all of them.
NO_PRIVATE_IPV4=

# ─── Resources ───────────────────────────────────────────────────────────────
# Archive keeps full state — give it enough RAM/cache, but leave headroom for
# the indexer writer and the OS on the same box.

RPC_MEM_LIMIT=4g
RPC_CPUS=1.5
RPC_DB_CACHE=1024
RPC_TRIE_CACHE=134217728

# ─── Ports ───────────────────────────────────────────────────────────────────
# This stack runs `network_mode: host`, so these bind DIRECTLY on the host —
# there is no container port mapping in between. Changing one moves the real
# listening socket.

# Outbound-only (see P2P_BIND) — no inbound firewall rule needed.
P2P_PORT=30333

# No --rpc-external, so the node listens on LOOPBACK only and is never reachable
# from the internet on any port. Point the indexer writer at
# ws://127.0.0.1:<this port>.
RPC_PORT=9944

# With host networking this binds on the public NIC — firewall it to the
# monitoring VPS only.
METRICS_PORT=9615
