# ─────────────────────────────────────────────────────────────────────────────
# Orbinum Testnet — dedicated ARCHIVE RPC for the indexer
#
#   cp .env.example .env
#
# Runs on the same box as the indexer writer. RPC is loopback-only (no Caddy,
# no public exposure), so no TLS/origin cert is needed here.
# ─────────────────────────────────────────────────────────────────────────────

# Container image (override to pin a specific tag)
ORBINUM_IMAGE=ghcr.io/orbinum/node:testnet-latest

# Friendly name shown in telemetry.
RPC_NAME=Orbinum-Indexer-RPC

# Report to Orbinum's telemetry — https://telemetry.orbinum.network
#
# On by default; set this to empty to opt out. This node is loopback-only, but
# telemetry is an OUTBOUND connection, so reporting does not expose the RPC — it
# publishes this node's name, version, block height, peer count and approximate
# location. Worth keeping on: a lagging indexer RPC is why the explorer falls
# behind, and telemetry shows that at a glance.
#
# The trailing slash and the verbosity level are both required, and the whole
# value must stay quoted — the node parses "<url> <level>" as one argument.
TELEMETRY_URL=--telemetry-url "wss://telemetry.orbinum.io/submit/ 0"

# This node's libp2p node-key (hex, 64 chars). Generate with:
#   openssl rand -hex 32
# Must be distinct from every other node's key.
RPC_NODE_KEY=

# P2P listen address. This node is OUTBOUND-ONLY: it dials the private network
# to sync, but nothing dials it. Binding to the private IP (not 0.0.0.0) keeps
# the listener off the public interface entirely. Leave EMPTY for 0.0.0.0.
#
# There is deliberately NO --public-addr here: the node never advertises a
# reachable address, so no peer tries to connect inbound. Do NOT open 30333
# inbound on the firewall — outbound connections still get their replies via
# conntrack, which is all syncing needs.
#
#   P2P_BIND=<this-node-private-ip>
P2P_BIND=

# Peering for the PRIVATE network. Leave EMPTY to discover the public testnet
# through the chain-spec bootnodes.
#
# Add --reserved-only so this node talks ONLY to the private network and never
# to public peers. Every entry is dialed outbound by this node. Omit this
# node's own address from the list:
#   RESERVED_NODES=--reserved-only --reserved-nodes /ip4/<peer-ip>/tcp/30333/p2p/<peer-id> --reserved-nodes /ip4/<peer-ip>/tcp/30333/p2p/<peer-id>
RESERVED_NODES=

# Public node → set to "--no-private-ipv4" (ignore RFC1918 peers). Private
# network whose reserved peers use internal IPs (10.x / 192.168.x / 172.16.x)
# → leave EMPTY, or that flag blocks peering with them.
#
# Defaults to EMPTY: if the reserved peers above use private IPs, this flag
# would make the node ignore all of them.
NO_PRIVATE_IPV4=

# Resource caps. Archive keeps full state — give it enough RAM/cache but always
# leave headroom for the indexer writer + OS on the same box.
RPC_MEM_LIMIT=4g
RPC_CPUS=1.5
RPC_DB_CACHE=1024
RPC_TRIE_CACHE=134217728

# ─── HOST ports ──────────────────────────────────────────────────────────────
# This node runs with `network_mode: host`, so these flags bind DIRECTLY on the
# host — there is no container port mapping in between. Changing a value here
# moves the real listening socket.

# P2P port. If you change it, open it in the firewall: it must stay publicly
# reachable or this node gets no peers.
#   P2P_PORT=34105
P2P_PORT=30333

# RPC port. The node has no --rpc-external, so it listens on LOOPBACK only and
# is never reachable from the internet on any port. Point the indexer writer at
# ws://127.0.0.1:<this port>.
RPC_PORT=9944

# Prometheus metrics port. With host networking this binds on the public NIC,
# so keep it firewalled to the monitoring VPS only.
METRICS_PORT=9615
