# ─────────────────────────────────────────────────────────────────────────────
# Orbinum Testnet — public RPC node
#
# Copy to `.env` on the RPC VPS and fill in the values below:
#   cp .env.example .env
#
# TLS: Caddy terminates HTTPS/WSS with a Cloudflare Origin Certificate. Drop
# origin.pem / origin.key next to this file before starting. The DNS record
# must be Proxied (orange cloud) in Cloudflare.
# ─────────────────────────────────────────────────────────────────────────────

# Compose derives the project name — and therefore the volume prefix — from the
# directory name, so this stack would look for `rpc_rpc-node-data`. Nodes first
# deployed from the old `docker/testnet/` layout have their chain DB in
# `testnet_rpc-node-data`; pinning the project name here reuses that volume
# instead of starting an archive resync from block 0. Keep it set on fresh
# installs too, so the volume name no longer depends on where the repo is cloned.
COMPOSE_PROJECT_NAME=testnet

# Container image (override to pin a specific tag)
ORBINUM_IMAGE=ghcr.io/orbinum/node:testnet-latest

# Friendly name shown in telemetry. Use rpc-1 / rpc-2 / ... per node.
RPC_NAME=Orbinum-RPC-1

# This RPC's libp2p node-key (hex, 64 chars). Generate with:
#   openssl rand -hex 32
RPC_NODE_KEY=

# Peers this node is allowed to talk to. Empty by default: a public RPC should
# discover peers freely.
#
# Pin it during a recovery. The chainspec's bootNodes are the RPCs themselves,
# so a freshly purged RPC discovers whatever is on the network — including a
# third-party node still serving a dead fork, which it will happily sync from
# because that chain is longer. Restricting it to your own validators for the
# duration of the resync is what stops that; clear it again afterwards.
#
#   RESERVED_NODES=--reserved-only --reserved-nodes /ip4/<validator-ip>/tcp/30333/p2p/<peer-id> --reserved-nodes /ip4/<validator-ip>/tcp/30333/p2p/<peer-id>
RESERVED_NODES=

# Public domain for this RPC. Caddy proxies HTTPS/WSS to localhost:9944.
# Use rpc-1 / rpc-2 / ... per node.
RPC_DOMAIN=rpc-1.testnet.orbinum.io

# Resource caps for the node container, so a query flood can't starve the host
# (Caddy, SSH, the OS). Always leave some RAM and CPU for the host — never give
# the container the full core count. Values below suit a 2 vCPU / 8 GB VPS;
# scale up to match your server.
RPC_MEM_LIMIT=6g
RPC_CPUS=1.5
