# Orbinum Testnet — relayer stack.
#
# The Tesseract signers do NOT live here: it does not expand environment variables in its
# config, so they go directly in `relayer.toml` (copied from relayer.toml.example).

ORBINUM_IMAGE=ghcr.io/orbinum/node:testnet-latest
RPC_NAME=Orbinum-Relayer-RPC

# Required. Generate with:
#   docker run --rm ghcr.io/orbinum/node:testnet-latest key generate-node-key
RPC_NODE_KEY=

TELEMETRY_URL=--telemetry-url "wss://telemetry.orbinum.io/submit/ 0"
P2P_BIND=
RESERVED_NODES=
NO_PRIVATE_IPV4=

# Smaller than the public RPC and the indexer's: this node prunes state and serves one
# consumer. `prove_finality` reads justifications and headers, not historical state.
RPC_MEM_LIMIT=3g
RPC_CPUS=1.5
RPC_DB_CACHE=512
RPC_TRIE_CACHE=67108864

# Peer slots. Half of what the public RPC runs: this node serves one local consumer, so a
# wide mesh only costs bandwidth and memory. Enough peers to stay on the canonical chain.
IN_PEERS=32
OUT_PEERS=8

# Blocks of state to keep. The relayer never reads historical state, so this only needs
# to cover normal operation. Raise it if the node is ever asked to serve state queries.
RPC_STATE_PRUNING=1000

TESSERACT_MEM_LIMIT=2g
TESSERACT_CPUS=1.0

# Change these if the box already runs another node.
P2P_PORT=30333
RPC_PORT=9944
METRICS_PORT=9615
