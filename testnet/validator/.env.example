# ─────────────────────────────────────────────────────────────────────────────
# Orbinum Testnet — VALIDATOR node
#
# Copy to `.env` on the validator VPS and fill in the values below:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Container image (override to pin a specific tag)
ORBINUM_IMAGE=ghcr.io/orbinum/node:testnet-latest

# Friendly name shown in telemetry. Pick something identifiable.
VALIDATOR_NAME=Choose-Your-Validator-Name

# Report to Orbinum's telemetry — https://telemetry.orbinum.network
#
# On by default. Reporting publishes this node's name, version, block height,
# peer count and approximate location; set this to empty to opt out.
#
# The trailing slash and the verbosity level are both required, and the whole
# value must stay quoted — the node parses "<url> <level>" as one argument.
#
# Validators report at level 1, where the node also sends `afg.authority_set`
# — the only message carrying its validator address, which the dashboard shows
# in the Address column. Level 0 omits it, so the column stays empty. The cost
# is per-block chatter the dashboard discards. RPC nodes stay at 0: they have
# no address to report.
TELEMETRY_URL=--telemetry-url "wss://telemetry.orbinum.io/submit/ 1"

# This validator's libp2p node-key (hex, 64 chars). Generate with:
#   openssl rand -hex 32
VALIDATOR_NODE_KEY=

# P2P bind address. The node binds 0.0.0.0:30333, auto-detects its public
# address, and discovers the network through the bootNodes baked into
# chainspec/testnet-spec.json. Just make sure TCP port 30333 is open and
# publicly reachable. Leave at 0.0.0.0 unless you bind to a specific interface.
P2P_BIND=0.0.0.0

# The address peers should dial this node on. Set it when the node sits behind
# a private network and cannot auto-detect a reachable address — validators on
# a private VPC advertise their VPC IP here so the other validators find them.
#
#   PUBLIC_ADDR=--public-addr /ip4/10.0.0.20/tcp/30333
PUBLIC_ADDR=

# Peers this validator is allowed to talk to.
#
# Validators on a private network pin each other here and add --reserved-only,
# so they never gossip with the public internet. That is also what keeps a
# purged validator from resyncing off a stranger's node: the chainspec's
# bootNodes are the public RPCs, and anything reachable through them may be
# serving a longer — but dead — fork.
#
# List every OTHER node this one should reach: the other validators, and the
# RPCs if they must follow this validator directly.
#
#   RESERVED_NODES=--reserved-only --reserved-nodes /ip4/10.0.0.21/tcp/30333/p2p/<peer-id> --reserved-nodes /ip4/10.0.0.22/tcp/30333/p2p/<peer-id>
RESERVED_NODES=

# ─── HOST ports ──────────────────────────────────────────────────────────────
# Inside the container the ports never change (30333 P2P, 9944 RPC, 9615
# metrics). These variables only move the HOST side, for validators that
# already use those ports or run their own numbering scheme.

# P2P port on the host. If you change it, open it in the firewall and advertise
# it on the SAME port:
#   P2P_PORT=34105
#   PUBLIC_ADDR=--public-addr /ip4/<your-public-ip>/tcp/34105
# Peers dial the ADVERTISED port: change one without the other and you are
# unreachable, with no peers.
P2P_PORT=30333

# RPC port on the host. A local `curl` (author_rotateKeys) targets this one:
#   RPC_PORT=26722   →   curl http://localhost:26722/
RPC_PORT=9944

# Interface the RPC port is published on.
#
# WARNING: this node runs `--rpc-methods Unsafe`. Under Unsafe,
# author_rotateKeys, author_insertKey and system_addReservedPeer take NO
# authentication: anyone who reaches the port can read or overwrite your
# session keys.
#
# Leave this at 127.0.0.1 — enough to rotate keys over SSH on the machine.
# NEVER set it to 0.0.0.0 or a public IP.
RPC_BIND=127.0.0.1

# Empty = the node listens for RPC on loopback INSIDE the container, which is
# the right default. Leave it empty unless you need to reach the RPC from the
# host: `--rpc-external` makes it listen on 0.0.0.0 inside the container, and
# RPC_BIND=127.0.0.1 above is then the only thing keeping it off the internet.
#   RPC_EXTERNAL=--rpc-external
RPC_EXTERNAL=

# Metrics port on the host.
METRICS_PORT=9615

# Address the metrics port (9615) is published on, for the monitoring VPS
# (10.0.0.40) to scrape. The node cannot choose a bind IP, so this is what
# keeps 9615 off the public NIC. Set it to THIS validator's private IP:
#   METRICS_BIND=10.0.0.20        # validator-1
# The 127.0.0.1 default fails closed: forget it and nothing is exposed.
METRICS_BIND=127.0.0.1
