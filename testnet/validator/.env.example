# ═══ Orbinum Testnet — VALIDATOR ═════════════════════════════════════════════
# cp .env.example .env
# ═════════════════════════════════════════════════════════════════════════════

# ─── Identity ────────────────────────────────────────────────────────────────

ORBINUM_IMAGE=ghcr.io/orbinum/node:testnet-latest

# Shown in telemetry. Pick something identifiable.
VALIDATOR_NAME=Choose-Your-Validator-Name

# libp2p node-key, hex 64 chars — unique per node.
#   openssl rand -hex 32
VALIDATOR_NODE_KEY=

# ─── Telemetry ───────────────────────────────────────────────────────────────

# https://telemetry.orbinum.network — on by default. Publishes name, version,
# height, peer count, approximate location. Empty to opt out.
#
# Validators use level 1, not 0: level 1 adds `afg.authority_set`, the only
# message carrying the validator address the dashboard shows in Address.
#
# Keep it quoted and keep the trailing slash — the node parses "<url> <level>"
# as one argument.
TELEMETRY_URL=--telemetry-url "wss://telemetry.orbinum.io/submit/ 1"

# ─── Peering ─────────────────────────────────────────────────────────────────

# Interface to bind. Leave 0.0.0.0 unless pinning to one interface.
P2P_BIND=0.0.0.0

# Address peers should dial. Only needed when the node cannot auto-detect a
# reachable one — e.g. a validator on a private VPC advertising its VPC IP.
#   PUBLIC_ADDR=--public-addr /ip4/10.0.0.20/tcp/30333
PUBLIC_ADDR=

# Restricts who this node talks to. Empty = discover via chainspec bootNodes.
#
# Two uses: validators on a private network pin each other with --reserved-only
# so they never gossip publicly; and during recovery it stops a purged node from
# resyncing off a stranger serving a longer-but-dead fork.
#
# List every OTHER node this one should reach, not itself.
#   RESERVED_NODES=--reserved-only --reserved-nodes /ip4/10.0.0.21/tcp/30333/p2p/<peer-id>
RESERVED_NODES=

# ─── Ports ───────────────────────────────────────────────────────────────────
# P2P uses ONE value on both sides of the mapping and in --listen-addr, so the
# listening, advertised and published ports cannot drift. RPC and metrics move
# only the host side (the container keeps 9944 / 9615) — nothing advertises
# those over the wire, so a remap there is invisible to peers.

# Open it in the firewall: must stay publicly reachable or no inbound peers.
P2P_PORT=30333

# A local `curl` (author_rotateKeys) targets this one:
#   RPC_PORT=26722  →  curl http://localhost:26722/
RPC_PORT=9944

# WARNING: this node runs `--rpc-methods Unsafe`. author_rotateKeys,
# author_insertKey and system_addReservedPeer take NO authentication — anyone
# who reaches the port can read or overwrite your session keys.
# Leave this at 127.0.0.1. NEVER 0.0.0.0 or a public IP.
RPC_BIND=127.0.0.1

# Empty = RPC on loopback INSIDE the container, which is the right default.
# --rpc-external makes it listen on 0.0.0.0 there, leaving RPC_BIND as the only
# thing keeping it off the internet.
#   RPC_EXTERNAL=--rpc-external
RPC_EXTERNAL=

METRICS_PORT=9615

# Interface metrics are published on, for the monitoring VPS to scrape. The node
# binds 0.0.0.0 inside the container, so this is what keeps the port off the
# public NIC. Set it to THIS validator's private IP:
#   METRICS_BIND=10.0.0.20
# The 127.0.0.1 default fails closed: forget it and nothing is exposed.
METRICS_BIND=127.0.0.1
