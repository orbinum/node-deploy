# ─────────────────────────────────────────────────────────────────────────────
# Orbinum Testnet — VALIDATOR node
#
# Copy to `.env` on the validator VPS and fill in the values below:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Container image (override to pin a specific tag)
ORBINUM_IMAGE=ghcr.io/orbinum/node:testnet-latest

# Friendly name shown in telemetry. Pick something identifiable.
VALIDATOR_NAME=Choose-Your-Validator-Name

# Report to Orbinum's telemetry — https://telemetry.orbinum.network
#
# On by default. Reporting publishes this node's name, version, block height,
# peer count and approximate location; set this to empty to opt out.
#
# The trailing slash and the verbosity level are both required, and the whole
# value must stay quoted — the node parses "<url> <level>" as one argument.
# Level 0 is the standard detail level; higher levels add per-block chatter.
TELEMETRY_URL=--telemetry-url "wss://telemetry.orbinum.io/submit/ 0"

# This validator's libp2p node-key (hex, 64 chars). Generate with:
#   openssl rand -hex 32
VALIDATOR_NODE_KEY=

# P2P bind address. The node binds 0.0.0.0:30333, auto-detects its public
# address, and discovers the network through the bootNodes baked into
# chainspec/testnet-spec.json. Just make sure TCP port 30333 is open and
# publicly reachable. Leave at 0.0.0.0 unless you bind to a specific interface.
P2P_BIND=0.0.0.0

# The address peers should dial this node on. Set it when the node sits behind
# a private network and cannot auto-detect a reachable address — validators on
# a private VPC advertise their VPC IP here so the other validators find them.
#
#   PUBLIC_ADDR=--public-addr /ip4/10.0.0.20/tcp/30333
PUBLIC_ADDR=

# Peers this validator is allowed to talk to.
#
# Validators on a private network pin each other here and add --reserved-only,
# so they never gossip with the public internet. That is also what keeps a
# purged validator from resyncing off a stranger's node: the chainspec's
# bootNodes are the public RPCs, and anything reachable through them may be
# serving a longer — but dead — fork.
#
# List every OTHER node this one should reach: the other validators, and the
# RPCs if they must follow this validator directly.
#
#   RESERVED_NODES=--reserved-only --reserved-nodes /ip4/10.0.0.21/tcp/30333/p2p/<peer-id> --reserved-nodes /ip4/10.0.0.22/tcp/30333/p2p/<peer-id>
RESERVED_NODES=

# Dirección donde se publica el puerto de métricas (9615) para que lo scrapee
# el VPS de monitoreo (10.0.0.40). El nodo no puede elegir IP de bind, así que
# esto es lo que evita exponer 9615 en la NIC pública. Ponlo en la IP privada
# de ESTE validador:
#   METRICS_BIND=10.0.0.20        # validator-1
# El default 127.0.0.1 falla cerrado: si se olvida, no se expone nada.
METRICS_BIND=127.0.0.1
